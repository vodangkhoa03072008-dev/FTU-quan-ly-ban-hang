NODE_ENV=development
DATABASE_URL="postgresql://cocart_user:cocart_password_2026@localhost:5432/cocart_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Hãy đổi toàn bộ các secret dưới đây (vd: openssl rand -hex 32). Ở NODE_ENV=production server sẽ từ chối khởi động nếu thiếu.
JWT_SECRET="change-me-jwt-secret"
QR_HMAC_SECRET="change-me-qr-hmac-secret"
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"
ALIAS_SALT="change-me-alias-salt"

BANK_BIN="970422"
BANK_ACCOUNT_NO="090123456789"

# Chỉ dùng khi demo: bật /api/auth/demo-login và nút "Thanh toán nhanh" (bỏ qua webhook ngân hàng).
# Tự động bị vô hiệu ở NODE_ENV=production.
ALLOW_DEMO_PAYMENT=true

# Giả định ước tính CO2 mỗi chuyến giao lẻ (gram). CHỈ là giả định, cần thay bằng số liệu đo/nguồn tham chiếu khi báo cáo.
CO2_GRAMS_PER_TRIP=420
MAX_MEMBERS_PER_CART=10
QR_TTL_MINUTES=120

FRONTEND_URL="http://localhost:3000"
PORT=4000
